# Vercel: connect an Upstash Redis integration and set these server-only values.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional namespace. Use separate values/databases for preview and production.
SCHOOLITY_STORE_PREFIX=schoolity
# Required on Vercel for "Keep me signed in". 32 random bytes, standard base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SCHOOLITY_REMEMBER_KEY=
